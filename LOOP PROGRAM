print("===== LOOP PROGRAM =====")

# ১ থেকে ১০০ পর্যন্ত যোগফল
total = 0

for i in range(1, 101):
    total += i

print("1 থেকে 100 পর্যন্ত যোগফল =", total)

print("\nজোড় সংখ্যা:")
for i in range(2, 51, 2):
    print(i, end=" ")

print("\n\nবিজোড় সংখ্যা:")
for i in range(1, 50, 2):
    print(i, end=" ")

print("\n\n৫ এর নামতা:")

for i in range(1, 11):
    print(f"5 x {i} = {5*i}")

print("\nCountdown:")

count = 10

while count > 0:
    print(count)
    count -= 1

print("Finished!")
